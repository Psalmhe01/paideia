{
  "name": "paideia",
  "version": "1.0.0",
  "description": "Paideia — Theological Library, Primary Sources, Attachments & Catechetical Quiz Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT \"tsx watch server/dev.ts\" \"vite\"",
    "dev:server": "tsx watch server/dev.ts",
    "dev:client": "vite",
    "build": "tsx server/buildSeedAssets.ts && vite build",
    "build:client": "vite build",
    "build:seed-assets": "tsx server/buildSeedAssets.ts",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seedCli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/blob": "^2.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.68.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.16.0 || ^24.0.0 || >=26.0.0"
  }
}
